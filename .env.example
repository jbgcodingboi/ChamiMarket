# Copy to .env.local for local development against a Supabase project.
# Both values are public (Supabase dashboard > Project Settings > API).
# Leave them empty to run in local mode (accounts stay in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the private placeholder domain for username-only logins.
# Pick it once; changing it later breaks existing username logins.
# VITE_USERNAME_EMAIL_DOMAIN=users.chamimarket.app

# Only for running the sync job by hand (npm run sync). Never put this in a VITE_ variable.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
